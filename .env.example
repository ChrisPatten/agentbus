# Secrets referenced from config.yaml as ${VAR_NAME}. Never commit this file.

# Telegram bot token from @BotFather. Named instances use one variable per bot,
# for example TELEGRAM_BOT_TOKEN_PEGGY.
TELEGRAM_BOT_TOKEN=

# Email adapter: an app-specific password, not the account password.
ICLOUD_APP_PW=

# Only needed when memory.structured_extraction is true (legacy summarizer).
ANTHROPIC_API_KEY=
