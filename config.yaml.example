# AgentBus configuration reference. Copy to config.yaml and edit.
# Secrets are referenced as ${VAR_NAME} and resolved from .env at startup.
# A leading ~ in any path value expands to your home directory.

bus:
  http_port: 3000
  # host: 127.0.0.1           # default: loopback only. 0.0.0.0 exposes every route to the LAN;
  #                           # set auth_token if you do that. See docs/DEPLOYMENT.md.
  # auth_token: ${BUS_TOKEN}  # if set, every request except /api/v1/health needs X-Bus-Token
  db_path: ~/.agentbus/agentbus.db
  log_level: info             # accepted, but not yet applied to log output

adapters:
  # ── Telegram — docs/TELEGRAM_ADAPTER.md ──────────────────────────────────────
  # Single-bot form (adapter id and channel: "telegram"):
  telegram:
    token: ${TELEGRAM_BOT_TOKEN}
    poll_timeout: 30          # long-poll timeout in seconds
  # Multi-bot form (ids "telegram:peggy", "telegram:jarvis"):
  # telegram:
  #   peggy:
  #     token: ${TELEGRAM_BOT_TOKEN_PEGGY}
  #   jarvis:
  #     token: ${TELEGRAM_BOT_TOKEN_JARVIS}

  # ── Email (IMAP IDLE inbound, SMTP outbound) — docs/EMAIL_ADAPTER.md ─────────
  # Defaults target iCloud. Each email thread becomes its own long-lived session.
  # email:
  #   imap:
  #     host: imap.mail.me.com
  #     port: 993
  #     user: assistant@icloud.com
  #     password: ${ICLOUD_APP_PW}   # app-specific password, not the Apple ID password
  #     mailbox: INBOX
  #   smtp:
  #     host: smtp.mail.me.com
  #     port: 587
  #     from: Assistant <assistant@icloud.com>   # defaults to imap.user
  #   require_auth: true             # drop mail that fails SPF/DKIM/DMARC for its From domain
  # Multi-account form (ids "email:peggy", "email:work"):
  # email:
  #   peggy:
  #     imap: { user: peggy@icloud.com, password: ${ICLOUD_APP_PW_PEGGY} }
  #   work:
  #     imap: { host: imap.fastmail.com, user: me@work.com, password: ${FASTMAIL_PW} }

  # ── Pebble Ring voice-memo webhook — docs/PEBBLE_ADAPTER.md ──────────────────
  # pebble:
  #   enabled: true
  #   max_body_bytes: 65536
  #   logging:
  #     enabled: false               # log every raw request to <dir>/pebble/<date>.jsonl
  #     dir: logs/webhooks

  # ── Siri channel (Peggy iOS app) — docs/SIRI_ADAPTER.md ──────────────────────
  # POST /api/v1/siri/ask holds the request open until the agent's reply arrives.
  # siri:
  #   enabled: true
  #   reply_timeout_ms: 25000        # server-side cap on how long an ask waits (1000-60000)
  #   max_body_bytes: 8192
  #   debug_delay_ms: 0              # device testing only; refused when NODE_ENV=production

  # ── Headless Claude Code (primary agent runtime) — docs/CC_HEADLESS_ADAPTER.md ─
  # Spawns `claude -p` per message batch and resumes the session on later turns.
  cc-headless:
    agent_id: claude
    poll_interval_ms: 1000
    claude_bin: claude
    # model: sonnet                  # --model for claude -p; unset defers to the CLI default
    working_dir: ~/agent             # cwd for claude -p: selects the CLAUDE.md hierarchy and memory dir
    error_reply: "Sorry — I hit an error processing that. Please try again."
    error_passthrough: false         # append the raw failure detail to error_reply
    system_prompt: |
      You are a helpful assistant for {{contact_id}} on {{channel}}.
      Today is {{date}}.
      Deliver every user-facing message by calling the `reply` tool with the
      message id shown as [id:<id>]. Do not put your answer only in plain text.
      Match your length to the channel: brief on telegram*, complete and
      structured on email*.
      Once you have replied, stop. A separate journaling process updates your
      memory files later. Exception: log financial decisions, health facts,
      scheduling commitments, and security-relevant account events immediately.
      {{memories}}
    memory:                          # memory files, relative to working_dir
      dir: memory
      index_file: MEMORY.md
      daily_subdir: daily
      journal_lookback_days: 3       # today plus the previous 2 days (0 = index only)
    journaling:                      # silent memory-update turn on pause or ceiling
      enabled: true
      threshold_ms:                  # idle debounce per channel; a number, or a map with `default`
        telegram: 300000             # 5 min
        email: 86400000              # 24 h
        default: 300000
      ceiling_ms: 1800000            # hard ceiling since the last sweep; unset disables it
      prompt: |
        Our conversation has paused. Review it and update your memory files
        (today's daily journal, MEMORY.md, and any relevant topic files) with
        anything durable worth remembering. Do NOT message the user.
  # Multi-instance form: one entry per headless agent, same fields as above.
  # cc-headless:
  #   peggy:
  #     agent_id: peggy
  #     working_dir: ~/peggy
  #     system_prompt: |
  #       You are Peggy...
  #   pokeclaude:
  #     agent_id: pokeclaude
  #     working_dir: ~/pokeclaude
  #     system_prompt: |
  #       You are pokeclaude...

  # ── Interactive Claude Code session pool over tmux — _bmad-output/epics/E48-cc-session-pool-tmux.md
  # A pool of tmux panes, each running its own interactive `claude` session; the bus
  # leases a pane per conversation on demand. Use this instead of cc-headless when you
  # want an attachable, watchable session (e.g. `tmux attach -t peggy-pool`) rather than
  # a one-shot `claude -p` per message batch.
  # cc-pool:
  #   agent_id: peggy                # logical agent routes target; panes get derived ids peggy-pool-<n>
  #   tmux_session: peggy-pool       # tmux session holding the panes
  #   panes: 4                       # pool size (windows created at startup)
  #   growth: fixed                  # fixed | dynamic (dynamic creates up to max_panes on demand)
  #   max_panes: 8                   # only meaningful when growth: dynamic; defaults to panes
  #   claude_bin: /Users/chrispatten/.local/bin/claude   # must be absolute (a bare "claude" hits your shell function/alias, not the CLI)
  #   model: sonnet
  #   working_dir: /Users/chrispatten/workspace/peggy-claude-code
  #   launch_args:                   # appended verbatim to every launch/resume invocation
  #     - --dangerously-load-development-channels
  #   poll_interval_ms: 1000         # passed through to each pane's cc.ts
  #   launch_ack_delay_ms: 500       # wait, then send Enter to ack the experimental MCP channel prompt
  #   launch_ack_max_attempts: 3     # re-send Enter if capture-pane still shows the prompt
  #   launch_ack_pattern: "experimental"  # prompt text to match; override if the CLI rewords it
  #   pane_env:                      # set via `tmux new-window -e` (TERM/COLORTERM always added)
  #     CLAUDE_AUTOCOMPACT_PCT_OVERRIDE: "50"
  #   lease:
  #     idle_evict_ms: 1800000       # 30m without activity → evictable
  #     hard_idle_ms: 21600000       # 6h → proactively released even if pool is busy
  #     park_timeout_ms: 300000      # a parked message waits this long before erroring back
  #   on_evict: clear                # clear | kill (what happens to the pane on release)

  # ── Claude Code MCP adapter, polling mode (persistent session) — docs/CC_ADAPTER.md
  # claude-code:
  #   poll_interval_ms: 1000

contacts:
  alice:
    id: alice                        # must equal the map key
    displayName: Alice
    platforms:
      telegram:
        userId: 123456789
      # email:                       # inbound allowlist; a string or a list
      #   address:
      #     - alice@example.com
      # pebble:
      #   token: "long-random-bearer-token"   # identifies this contact on the Pebble webhook
      # siri:
      #   token: ${SIRI_TOKEN_ALICE}          # identifies this contact on /api/v1/siri; >= 16 chars, `openssl rand -hex 24`

topics:
  - general
  - reminders
  - code
  - personal

memory:
  structured_extraction: false       # legacy summarizer and memories store; see docs/MEMORY.md
  summarizer_interval_ms: 60000
  session_idle_threshold_ms: 1800000
  context_window_hours: 48
  claude_api_model: claude-sonnet-4-6

# Per-agent settings keyed by recipient id — docs/ATTACHMENTS.md
agents:
  "agent:claude":
    media:
      download_path: /tmp/agentbus/claude   # inbound images and files; created at startup
      ttl_seconds: 3600

pipeline:
  dedup_window_ms: 30000
  drop_unrouted: false               # true drops messages that match no route
  # topic_rules:                     # first match wins; keyword list and/or regex
  #   - topic: code
  #     keywords: [bug, deploy, PR]
  # urgency_keywords: [urgent, asap, emergency, critical]
  # vip_contacts: [alice]
  routes:
    - match:
        channel: telegram
      target:
        adapterId: cc-headless
        recipientId: agent:claude
    # - match: { channel: email }
    #   target: { adapterId: cc-headless, recipientId: agent:claude }
    # - match: { channel: pebble }
    #   target: { adapterId: cc-headless, recipientId: agent:claude }
    # - match: { channel: siri }
    #   target: { adapterId: cc-headless, recipientId: agent:claude }
  # relays:                          # re-submit on another channel — docs/CHANNEL_RELAY.md
  #   - match: { channel: pebble, sender: "contact:alice" }
  #     target:
  #       channel: telegram
  #       template: "Voice note:\n{{body}}"

scheduler:
  tick_interval_ms: 30000
  enabled: true

# schedules:                         # config-managed schedules — docs/SCHEDULING.md
#   - id: morning_briefing
#     cron: "0 8 * * 1-5"
#     timezone: America/New_York
#     channel: telegram
#     sender: contact:alice
#     prompt: "Summarize anything notable on my agenda today."
#     label: Morning briefing
