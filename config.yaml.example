bus:
  http_port: 3000
  db_path: ./data/agentbus.db
  log_level: info

adapters:
  # Single-bot form (adapter id: "telegram", channel: "telegram"):
  telegram:
    token: ${TELEGRAM_BOT_TOKEN}
    poll_timeout: 30
  #
  # Multi-bot form (adapter ids: "telegram:peggy", "telegram:jarvis"):
  # telegram:
  #   peggy:
  #     token: ${TELEGRAM_BOT_TOKEN_PEGGY}
  #   jarvis:
  #     token: ${TELEGRAM_BOT_TOKEN_JARVIS}
  #
  # Email adapter (E21) — IMAP IDLE inbound + SMTP outbound. Each email thread
  # becomes its own long-lived session. Defaults target iCloud; set host/port for
  # any provider. iCloud needs an app-specific password. See docs/EMAIL_ADAPTER.md.
  #
  # Single-account form (adapter id "email", channel "email"):
  # email:
  #   imap:
  #     host: imap.mail.me.com      # iCloud default
  #     user: peggy@icloud.com
  #     password: ${ICLOUD_APP_PW}  # app-specific password, NOT the Apple ID password
  #     mailbox: INBOX
  #   smtp:
  #     host: smtp.mail.me.com      # iCloud default
  #     from: Peggy <peggy@icloud.com>   # defaults to imap.user
  #   require_auth: true            # drop SPF/DKIM/DMARC failures (anti-spoofing)
  #
  # Multi-account form (adapter ids "email:peggy", "email:work"):
  # email:
  #   peggy:
  #     imap: { user: peggy@icloud.com, password: ${ICLOUD_APP_PW_PEGGY} }
  #   work:
  #     imap: { host: imap.fastmail.com, user: me@work.com, password: ${FASTMAIL_PW} }
  bluebubbles:
    server_url: http://localhost:1234
    webhook_port: 3002
  claude-code:
    poll_interval_ms: 1000
  # Headless Claude Code adapter (E19/E20) — spawns `claude -p` per message
  # batch instead of a persistent MCP session. See docs/CC_HEADLESS_ADAPTER.md
  # and docs/MEMORY_MODEL.md. Uncomment to use instead of (or alongside) claude-code.
  # cc-headless:
  #   agent_id: claude
  #   poll_interval_ms: 1000
  #   claude_bin: claude
  #   working_dir: /home/agent      # cwd for claude -p → selects the CLAUDE.md hierarchy
  #   error_reply: "Sorry — I hit an error processing that. Please try again."
  #   error_passthrough: false      # append raw failure detail to error_reply
  #   system_prompt: |
  #     You are a helpful assistant for {{contact_id}} on {{channel}}.
  #     Today is {{date}}.
  #     Deliver every user-facing message by calling the `reply` tool ([id:<id>]).
  #     Match your length and formality to the channel:
  #       - telegram*: reply briefly and conversationally (1–3 sentences).
  #       - email*:    write a complete, well-structured reply — a greeting, your
  #                    full reasoning in clear sections, and a sign-off. Take the
  #                    space email affords; this is not a chat message.
  #     @persona.md
  #     {{memories}}
  #   # E20: assemble the agent's own memory files into each turn (relative to working_dir)
  #   memory:
  #     dir: memory
  #     index_file: MEMORY.md
  #     daily_subdir: daily
  #     journal_lookback_days: 3    # today + previous 2 days (0 = index only)
  #   # E20: silent journaling turn when a conversation pauses (messages no one)
  #   journaling:
  #     enabled: true
  #     threshold_ms:               # per-channel idle gap before journaling
  #       telegram: 1800000         # 30 min
  #       email: 86400000           # 24 h
  #       default: 1800000
  #     prompt: |
  #       Our conversation has paused. Review it and update your memory files
  #       (today's daily journal, MEMORY.md, and any relevant topic files) with
  #       anything durable worth remembering. Do NOT message the user — this is
  #       an internal journaling turn, not a reply.

contacts:
  alice:
    id: alice
    displayName: Alice
    platforms:
      telegram:
        userId: 123456789
        username: alice_example
      bluebubbles:
        handle: "+15551234567"
      # Email allowlist — only mail from these addresses (case-insensitive)
      # resolves to this contact; anything else is dropped. String or list.
      email:
        address:
          - alice@example.com
          - alice@work.com

topics:
  - general
  - reminders
  - code
  - personal

memory:
  summarizer_interval_ms: 60000
  session_idle_threshold_ms: 1800000
  context_window_hours: 48
  claude_api_model: claude-opus-4-6
  # E20: the structured memory store (memories / session_summaries) is dormant by
  # default — the agent's own files are the source of truth (see docs/MEMORY_MODEL.md).
  # Set true to restore legacy summarizer extraction for MCP-adapter deployments.
  structured_extraction: false

# Per-agent settings, keyed by recipient id (e.g. "agent:claude").
# See docs/ATTACHMENTS.md for the full inbound-image flow.
agents:
  "agent:claude":
    # Inbound images from Telegram are downloaded here. The directory is
    # created at startup if missing. Files are deleted after ttl_seconds
    # (default: 3600) by the attachment sweeper.
    media:
      download_path: /tmp/agentbus/claude
      ttl_seconds: 3600

pipeline:
  routes:
    # Route all telegram messages to the claude-code agent:
    - match:
        channel: telegram
      target:
        adapterId: claude-code
        recipientId: agent:claude
    # Multi-bot routing example (uncomment if using named telegram instances):
    # - match:
    #     channel: telegram:peggy
    #   target:
    #     adapterId: claude-code
    #     recipientId: agent:peggy
    # - match:
    #     channel: telegram:jarvis
    #   target:
    #     adapterId: claude-code
    #     recipientId: agent:jarvis
    # Email routing — send mail to the (headless) agent so it can reply in-thread:
    # - match:
    #     channel: email
    #   target:
    #     adapterId: cc-headless
    #     recipientId: agent:claude
